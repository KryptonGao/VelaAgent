{
  "name": "@vela/desktop",
  "version": "0.1.4",
  "shortVersion": "0.1.4",
  "private": true,
  "main": "./out/main/index.mjs",
  "scripts": {
    "test:sounds": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/notification-sounds.test.ts",
    "dev": "electron-vite dev --watch",
    "test:trace": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test ../../packages/agent/test/trace.test.ts test/trace-model.test.ts",
    "test:thinking-summary": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test ../../packages/agent/test/thinking-summary.test.ts ../../packages/agent/test/thinking-summary-http.test.ts test/thinking-summary.test.ts",
    "test:persistence": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/persistence.test.ts test/ui-storage.test.ts ../../packages/agent/test/conversation-persistence.test.ts ../../packages/agent/test/turn-timing.test.ts",
    "test:ui-storage": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/ui-storage.test.ts",
    "test:plan": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/plan-draft.test.ts test/plan-document.test.ts",
    "test:diff": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/diff-rows.test.ts",
    "test:turn-review": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/tool-diff.test.ts test/turn-review-state.test.ts test/turn-changes.test.ts test/diff-rows.test.ts",
    "test:version-control": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/version-control-graph.test.ts test/version-control-hunks.test.ts test/version-control-p2.test.ts test/diff-rows.test.ts",
    "test:conversations": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/conversation-search.test.ts test/conversation-activity.test.ts test/conversation-list.test.ts ../../packages/agent/test/conversation-rename.test.ts",
    "test:session-create": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --experimental-test-module-mocks --test test/session-create.test.ts",
    "test:image-viewer": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/image-viewer.test.ts",
    "test:browser": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/browser.test.ts test/browser-security.test.ts test/conversation-links.test.ts",
    "test:trace:preview": "node test/trace-preview-server.mjs",
    "test:center": "node test-center/server.mjs",
    "build": "electron-vite build",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@vela/agent": "workspace:*",
    "@vela/shared": "workspace:*",
    "@vela/workspace": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "minimatch": "10.2.6",
    "node-pty": "1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "^4.4.3",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "devicon": "^2.17.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "material-icon-theme": "5.38.1",
    "vite": "^7.3.6"
  }
}
