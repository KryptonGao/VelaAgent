    "test:scheduled-tasks:electron": "node test/scheduled-tasks-electron-smoke.mjs",
    "test:task-recipes": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --test test/task-recipes.test.ts test/task-recipes-p1.test.ts test/task-recipes-p2.test.ts test/task-recipes-team.test.ts ../../packages/agent/test/task-recipes.test.ts ../../packages/agent/test/recipe-generator.test.ts",
    "test:task-recipes:electron": "node test/task-recipes-electron-smoke.mjs"
